# Optional Supabase connection for src/lib/walletRepository.js.
# These two values are public browser configuration, protected by SQL RLS.
# Never put a database password, secret key, or service_role key in VITE_*.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-legacy-anon-key
